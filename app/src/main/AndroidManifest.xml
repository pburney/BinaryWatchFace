<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.burnilab.binarywatchface">

    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:allowBackup="true"
        android:hasCode="false"
        android:label="@string/app_name">

        <!-- Watch Face Format runtime version.
             v1 = Wear OS 4, v2 = Wear OS 5.  Bump to 3/4 if you target
             newer WFF features; verify against the current sample. -->
        <property
            android:name="com.google.wear.watchface.format.version"
            android:value="2" />

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Ship a 450x450 preview before publishing.  Not required for
             local `adb install` testing.
        <meta-data
            android:name="com.google.android.wearable.watchface.preview"
            android:resource="@drawable/preview" />
        -->
    </application>
</manifest>
